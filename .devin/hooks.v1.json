{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$d=(Get-Location).ProviderPath; for($i=0;$i -lt 32;$i++){ $p=Join-Path $d 'scripts\\awx_device_bus.py'; if((Test-Path -LiteralPath $p) -and (Test-Path -LiteralPath (Join-Path $d 'config\\project-resources.json'))){ & python -B $p hook --root $d; exit $LASTEXITCODE }; $n=Split-Path $d -Parent; if(!$n -or $n -eq $d){break}; $d=$n }; exit 0\"",
          "timeout": 40,
          "statusMessage": "Checking project resource capabilities",
          "additionalContextLimit": 512
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/source_edit_triage.ps1",
          "timeout": 15
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^(write|edit|apply_patch|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devin_pre_edit_guard.ps1",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent_work_guard.ps1",
          "timeout": 12
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent_work_guard.ps1",
          "timeout": 12
        }
      ]
    }
  ]
}

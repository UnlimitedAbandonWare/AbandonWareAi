{
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/AbandonWare/demo-1/demo-1/src/.codex/hooks/project_capabilities_hook.ps1",
          "timeout": 40,
          "statusMessage": "Checking project resource capabilities",
          "additionalContextLimit": 512
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/AbandonWare/demo-1/demo-1/src/.codex/hooks/source_edit_triage.ps1",
          "timeout": 15
        }
      ]
    }
  ],
  "PreToolUse": [
    {
      "matcher": "^(write|edit|apply_patch|notebook_edit)$",
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/AbandonWare/demo-1/demo-1/src/scripts/devin_pre_edit_guard.ps1",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/AbandonWare/demo-1/demo-1/src/scripts/agent_work_guard.ps1",
          "timeout": 12
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "powershell -NoProfile -ExecutionPolicy Bypass -File C:/AbandonWare/demo-1/demo-1/src/scripts/agent_work_guard.ps1",
          "timeout": 12
        }
      ]
    }
  ]
}

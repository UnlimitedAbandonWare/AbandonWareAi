{
  "tool": "gptpro-pack",
  "userOnly": true,
  "comment": "[USER-ONLY] Pack-GPTPro.bat profiles. Agents must not run/modify/auto-invoke unless the user explicitly asks. JSON because the tool uses stdlib only (no yaml dep).",
  "defaultOut": "C:/Users/nninn/OneDrive/Desktop/zipHome",
  "defaultProfile": "backup",
  "maxFileMb": 2.0,
  "maxZipMb": 128,
  "allowFiles": ["gradle/wrapper/gradle-wrapper.jar"],
  "evidence": {
    "evidenceDays": 3,
    "evidenceHistoryDays": 30,
    "maxScanFiles": 5000,
    "maxScanMb": 128,
    "maxScanSeconds": 30,
    "maxEvidenceMb": 24,
    "maxFileKb": 512,
    "rolloutDays": 3,
    "maxRollouts": 40,
    "maxRunDirs": 10,
    "maxHandoffReports": 40,
    "maxDebugFiles": 80,
    "maxFailureLogs": 40,
    "maxTimelineRows": 4000,
    "maxRolloutMb": 64
  },
  "profiles": {
    "main": {
      "include": ["main/java", "main/resources"]
    },
    "core": {
      "extends": "main",
      "include": [
        "build.gradle.kts",
        "settings.gradle",
        "settings.gradle.kts",
        "gradle.properties",
        "gradle/wrapper/gradle-wrapper.properties",
        "configs",
        "frontend/src",
        "frontend/scripts",
        "frontend/package.json",
        "frontend/next.config.mjs",
        "frontend/jsconfig.json",
        "agents.md",
        "README.md",
        ".env.example",
        "frontend/.env.example",
        "docs/PROJECT_STATUS.md",
        "docs/API_ROUTING_SPEC.md",
        "docs/architecture"
      ]
    },
    "full": {
      "extends": "core",
      "include": [
        { "path": "scripts", "ext": [".py", ".js", ".ps1", ".bat"] },
        { "path": "docs", "ext": [".md"] },
        "src/test"
      ]
    },
    "backup": {
      "comment": "full + Gradle wrapper/launcher BATs + .agents 규칙·스킬 + frontend 설정류 — 복원 가능한 90% 소스 백업. defaultProfile이라 인자 없이 실행 시 적용. (DevWatch.bat·frontend public/tsconfig 등 현 체크아웃에 없는 경로는 무해한 no-op)",
      "extends": "full",
      "include": [
        "gradlew",
        "gradlew.bat",
        "Start-RAG.bat",
        "Close-RAG.bat",
        "Verify-RAG.bat",
        "DevWatch.bat",
        "Pack-GPTPro.bat",
        "Git-Ship.bat",
        "Start-Agy-CLI.bat",
        "frontend/public",
        "frontend/tailwind.config.js",
        "frontend/postcss.config.js",
        "frontend/tsconfig.json",
        ".agents/skills",
        ".agents/rules",
        "GEMINI.md",
        ".gitignore",
        "gradle/wrapper/gradle-wrapper.jar"
      ]
    },
    "ctx": {
      "comment": "core 파일 선택 + GPT Pro 맥락 섹션 (_START_HERE/_RULES/_CURRENT_WORK/_CHANGES/_CODE_MAP/_RUNTIME/_TEST_INDEX). vendor/min JS 기본 제외(매니페스트 기록). --focus/--briefs/--drop-legacy 지원.",
      "extends": "core",
      "context": true,
      "include": []
    },
    "evidence": {
      "extends": "ctx",
      "context": true,
      "evidence": true,
      "include": []
    },
    "brief": {
      "comment": "ctx + java 골격화(본문 제거, --focus 매칭은 전문 유지). 목표 압축 전 ≤6MB — frontend·static·templates·장문 docs는 제외하고 맥락 섹션에 압축 반영. 기존 프로필 파일 선택 불변.",
      "extends": "core",
      "context": true,
      "skeletonJava": true,
      "excludePaths": [
        "frontend/",
        "main/resources/static/",
        "main/resources/templates/",
        "docs/PROJECT_STATUS.md",
        "docs/architecture/"
      ],
      "include": []
    }
  }
}

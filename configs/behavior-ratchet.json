{
  "schemaVersion": "awx.behavior-ratchet.config.v1",
  "doc": "docs/agents-rules/DEMO1-BEHAVIOR-RATCHET.md",
  "note": "One-way ratchet. Add entries freely; removing or loosening a LOCKED entry needs a user-approved ADR (status: ACCEPTED, approvedBy: user, ratchet: <id>) and `behavior_ratchet.py unlock`. Patterns are Python regex (multiline).",
  "entries": [
    {"id": "defaults.yaml.search-mode-auto", "kind": "present", "contract": "DEMO1-ASTRA-STANDARD-MEMORY-CONTEXT-10TURN-20261005 WP0-D",
     "file": "main/resources/application-llm.yaml", "section": {"start": "^  defaults:\\s*$", "mode": "indent"},
     "pattern": "^\\s+search-mode:\\s*['\"]?AUTO['\"]?\\s*(#.*)?$", "oldPattern": "^\\s+search-mode:\\s*['\"]?OFF['\"]?\\s*(#.*)?$"},
    {"id": "defaults.yaml.use-web-search-true", "kind": "present", "contract": "DEMO1-ASTRA-STANDARD-MEMORY-CONTEXT-10TURN-20261005 WP0-D",
     "file": "main/resources/application-llm.yaml", "section": {"start": "^  defaults:\\s*$", "mode": "indent"},
     "pattern": "^\\s+use-web-search:\\s*true\\b", "oldPattern": "^\\s+use-web-search:\\s*false\\b"},
    {"id": "defaults.yaml.use-rag-true", "kind": "present", "contract": "DEMO1-ASTRA-STANDARD-MEMORY-CONTEXT-10TURN-20261005 WP0-D",
     "file": "main/resources/application-llm.yaml", "section": {"start": "^  defaults:\\s*$", "mode": "indent"},
     "pattern": "^\\s+use-rag:\\s*true\\b", "oldPattern": "^\\s+use-rag:\\s*false\\b"},
    {"id": "defaults.ui.search-auto-selected", "kind": "present", "contract": "DEMO1-ASTRA-STANDARD-MEMORY-CONTEXT-10TURN-20261005 WP0-D",
     "file": "main/resources/templates/chat-ui.html",
     "pattern": "<option\\s+value=\"AUTO\"[^>]*\\bselected\\b", "oldPattern": "<option\\s+value=\"OFF\"[^>]*\\bselected\\b"},
    {"id": "defaults.ui.rag-checked", "kind": "present", "contract": "DEMO1-ASTRA-STANDARD-MEMORY-CONTEXT-10TURN-20261005 WP0-D",
     "file": "main/resources/templates/chat-ui.html",
     "pattern": "<input(?=[^>]*\\bid=\"useRagToggle\")(?=[^>]*\\bchecked\\b)[^>]*>"},
    {"id": "defaults.bridge.search-auto", "kind": "present", "contract": "DEMO1-ASTRA-STANDARD-MEMORY-CONTEXT-10TURN-20261005 WP0-D",
     "file": "main/resources/static/js/chat-settings-bridge.js",
     "pattern": "DEFAULTS\\s*=\\s*Object\\.freeze\\(\\{[^}]*searchMode:\\s*['\"]AUTO['\"]", "oldPattern": "DEFAULTS\\s*=\\s*Object\\.freeze\\(\\{[^}]*searchMode:\\s*['\"]OFF['\"]"},
    {"id": "defaults.bridge.rag-true", "kind": "present", "contract": "DEMO1-ASTRA-STANDARD-MEMORY-CONTEXT-10TURN-20261005 WP0-D",
     "file": "main/resources/static/js/chat-settings-bridge.js",
     "pattern": "DEFAULTS\\s*=\\s*Object\\.freeze\\(\\{[^}]*useRag:\\s*true", "oldPattern": "DEFAULTS\\s*=\\s*Object\\.freeze\\(\\{[^}]*useRag:\\s*false"},

    {"id": "searchmode.enum.no-standard", "kind": "absent", "contract": "10TURN WP0-D (STANDARD is a UI preset name, never a SearchMode enum value)",
     "files": ["main/java/com/example/lms/gptsearch/dto/SearchMode.java"], "pattern": "\\bSTANDARD\\b"},
    {"id": "merger.tier-order", "kind": "present", "contract": "10TURN WP0-D (FACTORY -> ADMIN_DB -> USER -> SESSION/REQUEST)",
     "file": "main/java/com/example/lms/api/ChatRequestSettingsMerger.java", "pattern": "List\\.of\\(\\s*admin\\s*,\\s*user\\s*\\)"},
    {"id": "merger.explicit-websearch-false-is-off", "kind": "present", "contract": "10TURN WP0-D (useWebSearch:false stays OFF)",
     "file": "main/java/com/example/lms/api/ChatRequestSettingsMerger.java", "pattern": "useWebSearch\"\\)\\)\\s*\\?\\s*\"AUTO\"\\s*:\\s*\"OFF\""},

    {"id": "rrf.plain-k60.reciprocal", "kind": "present", "contract": "GRAPH-HYBRID-REUSE R1 (plain RRF = 1/(60+rank))",
     "file": "main/java/com/example/lms/service/rag/fusion/ReciprocalRankFuser.java", "pattern": "this\\(\\s*60\\s*\\)"},
    {"id": "rrf.plain-k60.rrffusion", "kind": "present", "contract": "GRAPH-HYBRID-REUSE R1",
     "file": "main/java/com/example/lms/service/rag/fusion/RrfFusion.java", "pattern": "\\bK\\s*=\\s*60(\\.0)?\\b"},
    {"id": "rrf.weighted-k60-default", "kind": "present", "contract": "GRAPH-HYBRID-REUSE R1",
     "file": "main/java/com/example/lms/service/rag/fusion/WeightedReciprocalRankFuser.java", "pattern": "rrf\\.k:60\\}"},
    {"id": "rrf.no-temperature", "kind": "absent", "contract": "GRAPH-HYBRID-REUSE R1 / TEMPERATURE-SELFASK (RRF/BM25 have no temperature)",
     "files": ["main/java/com/example/lms/service/rag/fusion/*Reciprocal*.java", "main/java/com/example/lms/service/rag/fusion/*Rrf*.java"],
     "pattern": "(?i)\\btemperature\\b"},

    {"id": "tests.chat-defaults-yaml-contract", "kind": "test_names", "lang": "java", "contract": "10TURN WP0-D",
     "file": "src/test/java/com/example/lms/config/ChatDefaultsYamlContractTest.java"},
    {"id": "tests.settings-core-js", "kind": "test_names", "lang": "js", "contract": "10TURN WP0-D",
     "file": "src/test/js/settings-core.test.cjs"},
    {"id": "tests.selfask-planner", "kind": "test_names", "lang": "java", "contract": "DEMO1-TEMPERATURE-SELFASK-MODES-20261005",
     "file": "src/test/java/com/example/lms/service/rag/SelfAskPlannerTest.java"},
    {"id": "tests.weighted-rrf-fuser", "kind": "test_names", "lang": "java", "contract": "DEMO1-EXISTING-GRAPH-HYBRID-REUSE-20261005-R1",
     "file": "src/test/java/com/example/lms/service/rag/fusion/WeightedReciprocalRankFuserTest.java"},

    {"id": "rules.ratchet-doc", "kind": "present", "contract": "user 2026-10-05: rules must not revert",
     "file": "docs/agents-rules/DEMO1-BEHAVIOR-RATCHET.md", "pattern": "behavior_ratchet\\.py"},
    {"id": "rules.guard-common-pointer", "kind": "present", "contract": "user 2026-10-05",
     "file": "docs/agents-rules/DEMO1-AGENT-GUARD-COMMON.md", "pattern": "behavior_ratchet\\.py"},
    {"id": "rules.no-stale-search-off-default", "kind": "absent", "contract": "user 2026-10-05: rules follow the new AUTO default",
     "files": ["AGENTS.md", ".agents/rules/*.md", "docs/agents-rules/*.md", ".agents/skills/*/SKILL.md", ".devin/rules/*.md", ".windsurf/rules/*.md"],
     "exclude": ["docs/agents-rules/DEMO1-BEHAVIOR-RATCHET.md", "*.bak*"],
     "pattern": "(?i)((검색|search[ -]?mode|web[ -]?search)[^\\n]{0,16}기본(값)?[^\\n]{0,8}(OFF|끔|꺼짐|false))|(default[^\\n]{0,12}search[ -]?mode[^\\n]{0,8}OFF)|(search[ -]?mode[^\\n]{0,12}default[^\\n]{0,8}OFF)"},
    {"id": "rules.no-rrf-temperature-claim", "kind": "absent", "contract": "GRAPH-HYBRID-REUSE R1",
     "files": ["AGENTS.md", ".agents/rules/*.md", "docs/agents-rules/*.md", ".agents/skills/*/SKILL.md"],
     "exclude": ["docs/agents-rules/DEMO1-BEHAVIOR-RATCHET.md", "*.bak*"],
     "pattern": "(?i)(RRF|BM25)[^\\n]{0,10}(temperature|온도)\\s*(=|:)\\s*\\d"},
    {"id": "rules.no-standard-enum-claim", "kind": "absent", "contract": "10TURN WP0-D",
     "files": ["AGENTS.md", ".agents/rules/*.md", "docs/agents-rules/*.md", ".agents/skills/*/SKILL.md"],
     "exclude": ["docs/agents-rules/DEMO1-BEHAVIOR-RATCHET.md", "*.bak*"],
     "pattern": "SearchMode\\.STANDARD"}
  ]
}

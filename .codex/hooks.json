{
  "description": "Bound explicit demo-1 source edits to the repo-local three-way preflight.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=\"$PWD\"; while [ \"$d\" != / ]; do if [ -f \"$d/config/project-resources.json\" ] && [ -f \"$d/scripts/awx_device_bus.py\" ]; then exec python3 -B \"$d/scripts/awx_device_bus.py\" hook --root \"$d\"; fi; d=$(dirname \"$d\"); done; exit 0'",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\project_capabilities_hook.ps1",
            "timeout": 40,
            "statusMessage": "Checking project resource capabilities",
            "additionalContextLimit": 512
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'd=\"$PWD\"; n=0; i=0; found=\"\"; while [ \"$i\" -lt 32 ]; do if [ -e \"$d/.git\" ] && [ -f \"$d/AGENTS.md\" ] && [ -f \"$d/settings.gradle.kts\" ] && [ -f \"$d/build.gradle.kts\" ] && [ -f \"$d/.codex/hooks/source_edit_triage.sh\" ]; then n=$((n+1)); found=\"$d/.codex/hooks/source_edit_triage.sh\"; fi; [ \"$d\" = \"/\" ] && break; d=$(dirname \"$d\"); i=$((i+1)); done; if [ \"$n\" -eq 1 ]; then exec sh \"$found\"; fi; if [ \"$n\" -gt 1 ]; then echo source-edit-preflight-root-ambiguous >&2; else echo source-edit-preflight-root-unresolved >&2; fi; exit 2' ",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\source_edit_root_hook.ps1",
            "timeout": 2,
            "statusMessage": "Checking source-edit preflight",
            "additionalContextLimit": 512
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|write|edit|notebook_edit)$",
        "hooks": [
          {
            "type": "command",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devin_pre_edit_guard.ps1",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/devin_pre_edit_guard.ps1",
            "timeout": 15,
            "statusMessage": "Checking source-edit lease conflicts"
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent_work_guard.ps1",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent_work_guard.ps1",
            "timeout": 12,
            "statusMessage": "Checking path/retry work guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent_work_guard.ps1",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/agent_work_guard.ps1",
            "timeout": 12,
            "statusMessage": "Recording path/retry work guard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "commandWindows": "python -B scripts/deliver_to_downloads.py --hook-stop --quiet",
            "command": "python -B scripts/deliver_to_downloads.py --hook-stop --quiet",
            "timeout": 30,
            "statusMessage": "Checking dot-session brief delivery"
          }
        ]
      }
    ]
  }
}

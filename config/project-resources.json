    "database": ["DATABASE_URL", "DB_HOST", "DB_PORT", "DB_NAME", "DB_USERNAME", "DB_PASSWORD", "SPRING_DATASOURCE_URL", "SPRING_DATASOURCE_USERNAME", "SPRING_DATASOURCE_PASSWORD", "LMS_DB_URL", "LMS_DB_USERNAME", "LMS_DB_PASSWORD", "LMS_DB_DRIVER"],
    "neo4j": ["NEO4J_URI", "NEO4J_USER", "NEO4J_PASSWORD", "NEO4J_DATABASE", "RETRIEVAL_KG_NEO4J_URI", "RETRIEVAL_KG_NEO4J_USER", "RETRIEVAL_KG_NEO4J_PASSWORD", "RETRIEVAL_KG_NEO4J_DATABASE"],
